# Copy to .env (never committed). Read at build time by the main process
# only; the screens never see these values.

# Otto API (backend-otto). Local: http://localhost:4100
MAIN_VITE_API_URL=https://api-otto.vercel.app
# Same value as CLIENT_API_KEY of the API you point to.
MAIN_VITE_CLIENT_API_KEY=
